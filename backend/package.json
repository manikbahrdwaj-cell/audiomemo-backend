{
  "name": "voice-ws-server",
  "version": "1.0.0",
  "description": "WebSocket server for voice biometric authentication",
  "main": "websocket-handler.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "server": "node websocket-handler.js",
    "server:dev": "nodemon websocket-handler.js",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --testPathPattern=test_.*\\.test\\.js --config jest.config.js",
    "test:coverage": "jest --coverage --config jest.config.js",
    "test:watch": "jest --watch --config jest.config.js",
    "test:session": "node test-session-manager.js",
    "examples": "node session-manager-examples.js"
  },
  "keywords": [
    "websocket",
    "voice",
    "authentication",
    "biometric"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
