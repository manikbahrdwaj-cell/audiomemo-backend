# ============================================================================
# Voice Biometric Authentication API - Environment Configuration
# ============================================================================

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voice_authentication

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# Primary LLM Provider Selection
# Options: "openai" (recommended), "gemini"
LLM_PROVIDER=openai

# LLM Model Configuration
LLM_TEMPERATURE=0.1          # Temperature: 0-2. Lower = more deterministic
LLM_MAX_TOKENS=4096          # Maximum output tokens
LLM_TOP_P=0.95               # Nucleus sampling parameter

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================

# OpenAI API Key (required if LLM_PROVIDER=openai)
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Model Selection
# Options:
#   - gpt-4o (latest, recommended) - $15/$60 per 1M tokens
#   - gpt-4-turbo - $10/$30 per 1M tokens
#   - gpt-4 - $30/$60 per 1M tokens
#   - gpt-3.5-turbo - $0.50/$1.50 per 1M tokens
OPENAI_MODEL=gpt-4o

# ============================================================================
# GOOGLE GEMINI CONFIGURATION
# ============================================================================

# Google API Key (required if LLM_PROVIDER=gemini)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...your-key-here

# Gemini Model Selection
# Options:
#   - gemini-2.0-flash (latest, recommended, fastest) - $0.075/$0.30 per 1M tokens
#   - gemini-1.5-pro (most capable) - $3.50/$10.50 per 1M tokens
#   - gemini-1.5-flash (balanced) - $0.075/$0.30 per 1M tokens
GEMINI_MODEL=gemini-2.0-flash

# ============================================================================
# VOICE AUTHENTICATION CONFIGURATION
# ============================================================================

# Voice Chunk Configuration
VOICE_CHUNK_SIZE=8192        # Chunk size in bytes for audio processing
VOICE_SAMPLE_RATE=16000      # Sample rate in Hz (16kHz standard for voice)

# Similarity Threshold
VOICE_SIMILARITY_THRESHOLD=0.65  # Cosine similarity threshold for matching (0-1)

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Logging
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/app.log

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60   # Maximum API requests per minute

# Session Configuration
SESSION_TIMEOUT_MINUTES=30   # Session timeout in minutes
MAX_SESSIONS_PER_USER=5      # Maximum concurrent sessions per user

# ============================================================================
# LANGCHAIN CONFIGURATION
# ============================================================================

# LangChain Debug Mode
LANGCHAIN_DEBUG=False        # Set to True to enable detailed logging

# LangChain Tracing (optional)
LANGCHAIN_TRACING_V2=False   # Enable for LangSmith integration
LANGSMITH_API_KEY=           # Your LangSmith API key if tracing enabled
LANGSMITH_PROJECT=voice-agent  # LangSmith project name

# ============================================================================
# MODEL CACHING (Optional)
# ============================================================================

# Cache downloaded models locally
CACHE_DIR=./pretrained_models
SPEECHBRAIN_CACHE=./pretrained_models/speechbrain

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env and fill in your actual API keys
# 2. Never commit .env file to version control
# 3. For voice agent queries, use gpt-4o (OpenAI) or gemini-2.0-flash (Gemini)
# 4. For conversation, use temperature=0.7 instead of 0.1
# 5. Monitor token usage in OpenAI/Gemini dashboards to control costs
# 6. Gemini supports 1M token context window (can handle large documents)
# 7. OpenAI gpt-4o is faster and cheaper than gpt-4-turbo
